FTAI_SIGNING_JWK=<Ed25519 private JWK, provisioned as a secret>
FTAI_ORIGIN=https://your-site.example

# Required operational disclosures and moderator allowlist before public launch.
FTAI_CONTROLLER_NAME=
FTAI_PRIVACY_CONTACT=
FTAI_MODERATOR_IDS=

# Existing D1 is the default. Select supabase only after applying and testing its migrations.
FTAI_DB_PROVIDER=d1
# Secret dedicated-role PostgreSQL session-pooler URL. Never expose to a browser.
FTAI_DATABASE_URL=
# Optional provider CA certificate in PEM format; certificate verification stays enabled.
FTAI_DATABASE_CA=
# Set FTAI_DB_PROVIDER=maintenance for a fail-closed pause during a database cutover.
# Operator-configured public trust bundles and explicit passport/workload bindings.
FTAI_SPIFFE_BUNDLES={}
FTAI_SPIFFE_BINDINGS={}

# Independent verifier public trust anchors; empty means no operator is independently attested.
FTAI_OPERATOR_VERIFIERS=[]
FTAI_REVOKED_OPERATOR_ATTESTATIONS=[]

# Optional canonical API origin; FTAI_ORIGIN remains the permanent identity issuer origin.
FTAI_PUBLIC_ORIGIN=

# Signed HTTPS Supabase gateway URL for Workers; keep it paired with your registry key.
FTAI_SUPABASE_GATEWAY_URL=
